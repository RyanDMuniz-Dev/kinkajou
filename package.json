{
  "name": "kinkajou",
  "version": "0.8.0",
  "description": "CLI for creating web projects",
  "main": "dist/index.js",
  "bin": {
    "kajo": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs dist",
    "build:test": "tsc -p tsconfig.test.json && node scripts/copy-templates.mjs dist-test && node scripts/copy-package-json.mjs dist-test",
    "test": "pnpm run build:test && node --test \"dist-test/tests/**/*.test.js\""
  },
  "keywords": [
    "cli",
    "web",
    "scaffolding",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "7.0.2"
  }
}
